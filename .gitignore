!measurement/detection_model_project/rescue_detection/sample_images/fire/.gitkeep
!measurement/detection_model_project/rescue_detection/sample_images/survivor/
measurement/detection_model_project/rescue_detection/sample_images/survivor/*
!measurement/detection_model_project/rescue_detection/sample_images/survivor/.gitkeep
!measurement/detection_model_project/rescue_detection/export/
measurement/detection_model_project/rescue_detection/export/*
!measurement/detection_model_project/rescue_detection/export/.gitkeep
!measurement/detection_model_project/rescue_detection/annotations/
measurement/detection_model_project/rescue_detection/annotations/*
!measurement/detection_model_project/rescue_detection/annotations/.gitkeep
!measurement/detection_model_project/rescue_detection/dataset/
measurement/detection_model_project/rescue_detection/dataset/*
!measurement/detection_model_project/rescue_detection/dataset/.gitkeep
!measurement/detection_model_project/rescue_detection/training_results/
measurement/detection_model_project/rescue_detection/training_results/*
!measurement/detection_model_project/rescue_detection/training_results/.gitkeep
!measurement/detection_model_project/rescue_detection/base_weights/
measurement/detection_model_project/rescue_detection/base_weights/*
!measurement/detection_model_project/rescue_detection/base_weights/.gitkeep

