measurement/*
!measurement/requirements.txt
!measurement/models/.gitkeep
!measurement/configs/.gitkeep
!measurement/data/.gitkeep
!measurement/scripts/.gitkeep
!measurement/src/.gitkeep
!measurement/tests/.gitkeep
!measurement/tools/.gitkeep

