# =========================
# visualization (Unity)
# =========================

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
UserSettings/

# メッシュファイルは除外
visualization/RescueMapSystem/Assets/Meshs/*
!visualization/RescueMapSystem/Assets/Meshs/.gitkeep

# Resourcesフォルダ内データは除外
visualization/RescueMapSystem/Assets/Resources/*
!visualization/RescueMapSystem/Assets/Resources/.gitkeep

# MemoryCaptures
[Mm]emoryCaptures/

# Visual Studio / VS Code 用にUnityが自動生成するC#プロジェクトファイル(Unityが必要に応じて再生成)
*.csproj

# Visual Studioのソリューションファイル(Unityがプロジェクト名やアセンブリ構成に応じて再生成)
*.sln

# Visual Studioに必要なワークロードやコンポーネント情報を記録する設定ファイル(チームで「全員に同じVisual Studio構成を使わせたい」場合は管理することもあるが、個人研究・Unity用途では通常不要)
*.vsconfig

# UnityやVisual Studioがアップグレード時に生成したログ/レポートの可能性が高い(将来的に必要になる可能性あり)
*.htm

# 一旦保留
visualization/research-rescue-info-vision/
visualization/research-rescue-info-vision_clone_0/

