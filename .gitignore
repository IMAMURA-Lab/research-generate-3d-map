# =========================
# docs
# =========================

docs/*
!docs/.gitkeep

# =========================
# detection_model_project
# =========================

# フォルダのひな型(.gitkeep)のみ管理対象。N_日付_特筆事項/ 以下の実データは管理対象外
# (親が除外されると個別の再包含は効かないため、各階層ごとに un-ignore → 直下を再度 ignore → 次階層を un-ignore … と辿る)
detection_model_project/*
!detection_model_project/requirements.txt
!detection_model_project/tools/
detection_model_project/tools/*
!detection_model_project/tools/.gitkeep
!detection_model_project/sample_images/
detection_model_project/sample_images/*
!detection_model_project/sample_images/fire/
detection_model_project/sample_images/fire/*
!detection_model_project/sample_images/fire/.gitkeep
!detection_model_project/sample_images/survivor/
detection_model_project/sample_images/survivor/*
!detection_model_project/sample_images/survivor/.gitkeep
!detection_model_project/export/
detection_model_project/export/*
!detection_model_project/export/.gitkeep
!detection_model_project/annotations/
detection_model_project/annotations/*
!detection_model_project/annotations/.gitkeep
!detection_model_project/dataset/
detection_model_project/dataset/*
!detection_model_project/dataset/.gitkeep
!detection_model_project/training_results/
detection_model_project/training_results/*
!detection_model_project/training_results/.gitkeep
!detection_model_project/base_weights/
detection_model_project/base_weights/*
!detection_model_project/base_weights/.gitkeep

# =========================
# visualization (Unity)
# =========================

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
UserSettings/

# メッシュファイルは除外
visualization/RescueMapSystem/Assets/Meshs/*
!visualization/RescueMapSystem/Assets/Meshs/.gitkeep

# Resourcesフォルダ内データは除外
visualization/RescueMapSystem/Assets/Resources/*
!visualization/RescueMapSystem/Assets/Resources/.gitkeep

# MemoryCaptures
[Mm]emoryCaptures/

# Visual Studio / VS Code 用にUnityが自動生成するC#プロジェクトファイル(Unityが必要に応じて再生成)
*.csproj

# Visual Studioのソリューションファイル(Unityがプロジェクト名やアセンブリ構成に応じて再生成)
*.sln

# Visual Studioに必要なワークロードやコンポーネント情報を記録する設定ファイル(チームで「全員に同じVisual Studio構成を使わせたい」場合は管理することもあるが、個人研究・Unity用途では通常不要)
*.vsconfig

# UnityやVisual Studioがアップグレード時に生成したログ/レポートの可能性が高い(将来的に必要になる可能性あり)
*.htm

# 一旦保留
visualization/research-rescue-info-vision/
visualization/research-rescue-info-vision_clone_0/

